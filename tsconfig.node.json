{
  "compilerOptions": {
    "composite": true,
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "target": "ES2022",
    "baseUrl": ".",
    "paths": {
      "@shared/*": ["src/shared/*"],
      "@main/*": ["src/main/*"],
      "@worker/*": ["src/worker/*"]
    }
  },
  "include": [
    "vite.config.ts",
    "vitest.config.ts",
    "src/main/**/*.ts",
    "src/worker/**/*.ts",
    "src/shared/**/*.ts"
  ]
}
